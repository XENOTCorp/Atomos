{
  "rules": [
    {
      "id": "static",
      "module": "static",
      "methods": ["GET", "HEAD"],
      "include": ["/*"],
      "exclude": ["/api/*"]
    },
    {
      "id": "login",
      "module": "login",
      "methods": ["POST"],
      "include": ["/api/login"],
      "exclude": []
    },
    {
      "id": "session",
      "module": "session",
      "methods": ["GET"],
      "include": ["/api/session"],
      "exclude": []
    }
  ]
}
